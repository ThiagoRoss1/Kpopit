{
    "git": {
        "deploymentEnabled": {
            "main": true,
            "dev": true,
            "major-patch": true,
            "**": false
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/__spa-fallback.html"
        }
    ]
}