{
  "name": "kpopit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:host": "react-router dev --host",
    "build": "tsc -b && react-router build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "preview": "vite preview",
    "test:album": "node --experimental-strip-types --test tests/album/disclosureTiming.test.mjs tests/album/eagerArtwork.test.mjs",
    "test:e2e": "node e2e/run-files.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke --project=desktop",
    "test:lighthouse": "node lighthouse/run.mjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "5.2.2",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router": "7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.29",
    "dotenv": "18.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pg": "8.23.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
