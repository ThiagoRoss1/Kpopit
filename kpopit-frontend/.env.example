# KpopIt frontend environment. Copy to .env and fill in local values; never commit real secrets.
# VITE_* values are baked into the client bundle at build time, so none of them may be a secret
# the browser shouldn't see. "Default" is the value used when unset.

# --- API --------------------------------------------------------------------
# Required for production builds. Backend base URL without /api (src/services/api.ts, admin page);
# the dev server ignores it and proxies /api to http://127.0.0.1:5000.
VITE_API_URL=http://127.0.0.1:5000

# --- Storage (Cloudflare R2 CDN) ---------------------------------------------
# Required. Public image bucket URL for idol photos and album covers (src/utils/imageUrl.ts and components).
VITE_IMAGE_BUCKET_URL=https://images.example.com
# Required for uploaded avatars. Public avatars bucket URL (src/utils/resolveAvatarUrl.ts).
VITE_AVATARS_BUCKET_URL=https://avatars.example.com

# --- Auth / storage -----------------------------------------------------------
# Required. Key for the AES encryption of the anonymous token in localStorage (src/utils/tokenEncryption.ts).
VITE_ENCRYPTION_KEY=replace-with-a-local-dummy-key

# --- Feature flags ----------------------------------------------------------
# Optional. Registers the admin route (app/routes.ts, admin page). Default: false.
VITE_ADMIN_ENABLED=false
# Optional. Path of the admin route, used only with VITE_ADMIN_ENABLED=true (app/routes.ts). Default: unset (no route).
VITE_ADMIN_ROUTE=
# Optional. Shows the maintenance page instead of every route (app/root.tsx). Default: false.
VITE_MAINTENANCE_MODE=false
# Optional. Mounts /collections, its NavBar entry and the win card reveal. Default: false.
VITE_COLLECTION_ENABLED=false
# Optional. Shows the dismissible global notice banner (src/components/MainLayout/MainLayout.tsx). Default: false.
VITE_GLOBAL_NOTICE=false

# --- Build (not VITE_, never reaches the bundle) -----------------------------
# Build only. API the prerender reads the idol list/profiles from (app/prerender-api.ts).
# Default: http://127.0.0.1:5000 (local seeded backend); required when VERCEL_ENV=production.
PRERENDER_API_URL=http://127.0.0.1:5000
# Build only. Set by Vercel ("production" / "preview"); "preview" lets the prerender skip a missing API.
VERCEL_ENV=
# Build only. "true" adds the bundle analyzer report (vite.config.ts). Default: unset.
ANALYZE=

# --- Development / test only (Playwright E2E) --------------------------------
# Test only. Local E2E database URL (e2e/support/env.ts); falls back to DB_URL. Never a production copy.
E2E_DB_URL=postgresql://localhost:5432/kpopit_pre_major_patch
# Test only. Expected name of the E2E database (e2e/support/env.ts). Default: kpopit_pre_major_patch.
E2E_DB_NAME=
# Test only. Set by the E2E fixtures: "true" stops Vite and app/routes.ts from loading env files. Default: unset.
E2E_ISOLATED=
# Test only. Comma-separated image origins the E2E fixtures stub (e2e/support/fixtures.ts). Default: http://images.e2e.invalid.
E2E_STUB_IMAGE_ORIGINS=
# Test only. Site Playwright tests against (playwright.config.ts). Default: http://localhost:5173.
PLAYWRIGHT_BASE_URL=
