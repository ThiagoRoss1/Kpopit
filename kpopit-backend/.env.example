# KpopIt backend environment. Copy to .env and fill in local values; never commit real secrets.
# Every variable the backend code reads is listed here. "Default" is the value used when unset.

# --- Database ---------------------------------------------------------------
# Required. PostgreSQL URL for the app pool (services/get_db.py), init_db.py, migrations/migrations.py
# and scripts/bootstrap_db.py. No default: the app refuses to start without it.
DB_URL=postgresql://localhost:5432/kpopit_dev
# Optional. Database pg_dump reads for backups (e.g. the read-only kpopit_backup role). Default: DB_URL.
BACKUP_DB_URL=

# --- Auth -------------------------------------------------------------------
# Required. HS256 signing key, at least 32 characters (app.py, services/auth_service.py, utils/auth_helpers.py).
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# Optional. Access token lifetime in seconds (services/auth_service.py). Default: 3600.
JWT_ACCESS_TOKEN_EXPIRES=3600
# Optional. Refresh token and cookie lifetime in seconds (routes/auth.py, services/auth_service.py). Default: 2592000.
JWT_REFRESH_TOKEN_EXPIRES=2592000
# Optional, production only. Domain of the refresh cookie (routes/auth.py); ignored in development. Default: unset (host-only).
COOKIE_DOMAIN=

# --- Web / CORS -------------------------------------------------------------
# Required in production. Comma-separated CORS allowlist (app.py); development allows every origin. Default: unset.
FRONTEND_URL=http://localhost:5173
# Optional. "development" enables open CORS, plain-HTTP cookies, TEST_DATE_OFFSET and the email outbox. Default: production.
FLASK_ENV=development
# Optional. Root log level (app.py). Default: INFO.
LOG_LEVEL=INFO

# --- Email (Resend) ---------------------------------------------------------
# Required to send email. API key (services/email_service.py). Default: unset (sending fails).
RESEND_API_KEY=
# Required to send email. Sender address (services/email_service.py). Default: unset.
RESEND_EMAIL_FROM=KpopIt <no-reply@example.com>
# Required for email links. Frontend base URL of every link in emails (routes/email.py, services/email_service.py).
RESEND_EMAIL_FRONTEND_URL=http://localhost:5173

# --- Storage (Cloudflare R2) ------------------------------------------------
# Required for avatar uploads and backups. S3 endpoint of the R2 account (utils/r2.py, services/backup_service.py).
R2_ENDPOINT_URL=
# Required for backups. Keys of the backup bucket (services/backup_service.py).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required for avatar uploads. Keys, bucket and object prefix for user avatars (utils/r2.py).
R2_AVATARS_ACCESS_KEY_ID=
R2_AVATARS_SECRET_ACCESS_KEY=
R2_AVATARS_BUCKET_NAME=
R2_AVATARS_PREFIX=avatars
# Optional, script only. Public image bucket URL for scripts/extract_palettes.py; unset skips extraction.
R2_PUBLIC_URL=

# --- Backup -----------------------------------------------------------------
# Required for backups. Private bucket for DB dumps (services/backup_service.py); unset makes the backup fail closed.
R2_BACKUP_BUCKET_NAME=

# --- Tasks ------------------------------------------------------------------
# Optional. Bearer key for POST /api/tasks/backup (routes/tasks.py). Default: unset (route rejects every request).
BACKUP_AUTH_KEY=
# Optional. Bearer key for POST /api/tasks/purge-deleted-accounts (routes/tasks.py), called daily by
# .github/workflows/purge-accounts.yml. Default: unset (route rejects every request).
ACCOUNT_PURGE_AUTH_KEY=

# --- Feature flags ----------------------------------------------------------
# Optional. Registers the admin blueprint (app.py). Default: false.
ADMIN_ENABLED=false
# Optional. Answers every /api route with 503 (app.py). Default: false.
MAINTENANCE_MODE=false
# Optional. Registers the collections routes and the win -> card grant (services/collections_service.py). Default: false.
COLLECTION_ENABLED=false
# Optional. Registers the public profile lookup GET /api/profile/<username> (services/profile_service.py). Default: false.
PUBLIC_PROFILE_ENABLED=false
# Optional. Registers the calendar of past challenge days /api/calendar/* (services/calendar_service.py, app.py). Default: false; safe default: false.
CALENDAR_ENABLED=false
# Optional. Registers the idol XP routes /api/idol-xp/* (services/xp_service.py, app.py). Default: false; safe default: false.
IDOL_XP_ENABLED=false

# --- Development / test only ------------------------------------------------
# Test only. Set by test runners (utils/env.py); when set, .env is never loaded. Default: unset; never set it in this file.
PYTHON_DOTENV_DISABLED=
# Development only. Shifts the game day by N days (utils/dates.py); ignored unless FLASK_ENV=development. Default: 0.
TEST_DATE_OFFSET=0
# Development only. "outbox" writes emails as JSON files instead of calling Resend (services/email_service.py). Default: unset.
EMAIL_DELIVERY=
# Development only. Folder for outbox emails (services/email_service.py). Default: kpopit-backend/.email-outbox.
EMAIL_OUTBOX_DIR=
# Test only. Local disposable pytest database, must be named kpopit_test (tests/conftest.py). Default: DB_URL with /kpopit_test.
TEST_DB_URL=postgresql://localhost:5432/kpopit_test

# --- Seeding ----------------------------------------------------------------
# Required for init_db.py / seed_db.py. Folder with the seed CSVs (also scripts/generate_group_features_csv.py).
# Default: unset (scripts/bootstrap_db.py sets it to kpopit-backend/data).
DATA_FOLDER=./data
