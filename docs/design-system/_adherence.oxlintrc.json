{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/collections/**",
              "components/decoration/**",
              "components/feedback/**",
              "components/game/**",
              "components/icons/**",
              "components/labels/**",
              "components/puffpop/cards/**",
              "components/puffpop/filters/**",
              "components/puffpop/idol-hero/**",
              "components/puffpop/idol-profile/**",
              "components/puffpop/idol-related/**",
              "components/puffpop/idol-toolbar/**",
              "components/puffpop/nav/**",
              "components/puffpop/search/**",
              "components/puffpop/states/**",
              "components/puffpop/title/**",
              "components/surfaces/**",
              "ui_kits/puffpop/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DynaPuff|Major Mono Display|Caveat|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: DynaPuff, Major Mono Display, Caveat, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlbumCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|artist|type|year|img|lang|tag|index|delay|onClick|className|key|ref|className|style|children)$/]",
        "message": "<AlbumCard> doesn't accept that prop. Declared props: name, artist, type, year, img, lang, tag, index, delay, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlbumCard'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:Korean|Japanese|English)$/]",
        "message": "<AlbumCard> lang must be one of 'Korean' | 'Japanese' | 'English'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlbumSleeve'] > JSXAttribute > JSXIdentifier[name!=/^(?:coverSrc|coverHue|note|showQuestion|tape|tilt|width|pixelBlock|className|style|key|ref|className|style|children)$/]",
        "message": "<AlbumSleeve> doesn't accept that prop. Declared props: coverSrc, coverHue, note, showQuestion, tape, tilt, width, pixelBlock, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppliedChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onRemove|variant|key|ref|className|style|children)$/]",
        "message": "<AppliedChip> doesn't accept that prop. Declared props: label, onRemove, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppliedChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:chip|clear)$/]",
        "message": "<AppliedChip> variant must be one of 'chip' | 'clear'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|label|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: href, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cap'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|className|key|ref|className|style|children)$/]",
        "message": "<Cap> doesn't accept that prop. Declared props: tone, size, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cap'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|pink|muted|faint)$/]",
