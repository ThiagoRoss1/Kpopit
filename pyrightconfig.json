{
  "venvPath": "kpopit-backend",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "include": ["kpopit-backend"],
  "exclude": [
    "**/.venv",
    "**/__pycache__",
    "**/node_modules",
    "kpopit-backend/data",
    "kpopit-backend/templates",
    "kpopit-backend/scripts/inkit_layers"
  ],
  "executionEnvironments": [
    {
      "root": "kpopit-backend/scripts/inkit_layers",
      "extraPaths": [
        "kpopit-backend/scripts/inkit_layers/.venv/Lib/site-packages",
        "kpopit-backend/scripts/inkit_layers/.venv/lib/python3.14/site-packages"
      ]
    },
    { "root": "kpopit-backend" }
  ]
}
